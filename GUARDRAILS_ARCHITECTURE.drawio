        <!-- ===== GUARDRAILS (the star) ===== -->
        <mxCell id="h-guard" value="★ NeMo GUARDRAILS — input rail" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#a371f7;" vertex="1" parent="1">
