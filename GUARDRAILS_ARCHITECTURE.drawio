        <mxCell id="gate" value="&lt;b&gt;🛡 Input Rail — check_input()&lt;/b&gt;  ★&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;atlas/brain/guardrails.py&lt;/font&gt;&lt;hr&gt;&lt;font style=&quot;font-size:9px&quot;&gt;EVERY command passes through here first&lt;br&gt;&lt;b&gt;ALLOW&lt;/b&gt; → the Brain  ·  &lt;b&gt;BLOCK&lt;/b&gt; → refusal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#553c9a;strokeColor=#b794f4;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" vertex="1" parent="1">
